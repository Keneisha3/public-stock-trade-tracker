# Copy this file to .env (same folder) and fill in your PAPER keys.
# .env is git-ignored: it never goes to GitHub. Never paste keys into a chat.
#
# Only needed for "broker": "alpaca-paper" in trader/team/config.json.
# The default "sim" mode needs no keys at all.
#
# Alpaca: log in, switch to the PAPER account (top left), then API Keys > Generate.
# Paper keys start with PK. The bot refuses any other key.
TRADING_MODE=paper
PAPER_API_KEY=PK_your_paper_key_here
PAPER_API_SECRET=your_paper_secret_here
PAPER_API_BASE_URL=https://paper-api.alpaca.markets

# Optional, paid: end-of-day prices that include companies no longer listed (Yahoo drops
# them), so backtests stop favouring survivors. https://eodhd.com (about US$20 a month).
# Locally put it here; for the GitHub research runs add it as the EODHD_API_KEY secret.
EODHD_API_KEY=
